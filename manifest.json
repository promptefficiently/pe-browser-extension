        "https://app.fireworks.ai/*",
        "https://openrouter.ai/*",
        "https://modelstudio.console.alibabacloud.com/*",
        "https://dashscope.console.aliyun.com/*",
        "https://bigmodel.cn/*",
        "https://www.bigmodel.cn/*",
        "https://z.ai/*",
        "https://www.z.ai/*",
        "https://platform.moonshot.ai/*",
        "https://platform.moonshot.cn/*",
        "https://dashboard.cohere.com/*"
