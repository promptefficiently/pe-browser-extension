  "browser_specific_settings": {
    "gecko": {
      "id": "hello@promptefficiently.com",
      "strict_min_version": "121.0"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://promptefficiently.com/*"
  ]
