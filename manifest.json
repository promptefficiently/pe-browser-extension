        "https://perplexity.ai/*",
        "https://chat.z.ai/*",
        "https://character.ai/*",
        "https://www.character.ai/*",
        "https://higgsfield.ai/*",
        "https://www.higgsfield.ai/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://x.ai/*",
