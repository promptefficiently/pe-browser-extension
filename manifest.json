        "https://www.bigmodel.cn/*",
        "https://z.ai/*",
        "https://www.z.ai/*",
        "https://platform.moonshot.ai/*",
        "https://platform.moonshot.cn/*",
        "https://dashboard.cohere.com/*"
      ],
      "js": [
        "storage.js",
        "estimator.js",
        "share-card.js",
        "content.js"
      ],
      "css": [
        "bubble.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://promptefficiently.com/*",
        "https://www.promptefficiently.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon48-light.png"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://www.kimi.com/*",
