{
  "manifest_version": 3,
  "name": "Prompt Efficiently",
  "version": "0.4.5",
  "description": "Get a rough AI usage estimate. Before you send.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.kimi.com/*",
        "https://www.kimi.ai/*",
        "https://chat.qwen.ai/*",
